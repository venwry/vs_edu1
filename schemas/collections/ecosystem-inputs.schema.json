{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "ecosystem_forecast_policy"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/collections/ecosystem-inputs.schema.json"
    },
    "schema_version": {
      "const": "3.0.0"
    },
    "ecosystem_forecast_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "counting",
        "host_retirement_per_quarter",
        "external_flexibus_attach",
        "cpm_copies_per_new_host",
        "cpm_copies_per_existing_host_quarter",
        "native_copies_per_new_host",
        "native_copies_per_existing_host_quarter",
        "devices_per_new_host",
        "devices_per_existing_host_quarter",
        "hardware_category_weights",
        "long_tail_categories",
        "native_categories",
        "scenarios",
        "uncertainty",
        "readiness",
        "porting_effort_assumptions",
        "oem_prospects",
        "application_candidates",
        "popular_hardware",
        "historical_sources"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "counting": {
          "type": "array"
        },
        "host_retirement_per_quarter": {
          "type": "number"
        },
        "external_flexibus_attach": {
          "type": "number"
        },
        "cpm_copies_per_new_host": {
          "type": "number"
        },
        "cpm_copies_per_existing_host_quarter": {
          "type": "number"
        },
        "native_copies_per_new_host": {
          "type": "number"
        },
        "native_copies_per_existing_host_quarter": {
          "type": "number"
        },
        "devices_per_new_host": {
          "type": "number"
        },
        "devices_per_existing_host_quarter": {
          "type": "number"
        },
        "hardware_category_weights": {
          "type": "object"
        },
        "long_tail_categories": {
          "type": "array"
        },
        "native_categories": {
          "type": "array"
        },
        "scenarios": {
          "type": "array"
        },
        "uncertainty": {
          "type": "string"
        },
        "readiness": {
          "type": "array"
        },
        "porting_effort_assumptions": {
          "type": "array"
        },
        "oem_prospects": {
          "type": "array"
        },
        "application_candidates": {
          "type": "array"
        },
        "popular_hardware": {
          "type": "array"
        },
        "historical_sources": {
          "type": "array"
        },
        "compatibility_pool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "annual_discoverable_families",
            "qualification_fraction",
            "qualification_delay_quarters",
            "counting",
            "sales_treatment",
            "partner_support",
            "historical_sources"
          ],
          "properties": {
            "basis": {
              "type": "string"
            },
            "annual_discoverable_families": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "qualification_fraction": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "qualification_delay_quarters": {
              "type": "integer",
              "minimum": 1
            },
            "counting": {
              "type": "string"
            },
            "sales_treatment": {
              "type": "string"
            },
            "partner_support": {
              "type": "string"
            },
            "historical_sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "url",
                  "claim"
                ],
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "claim": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "external_platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ]
      }
    }
  }
}
