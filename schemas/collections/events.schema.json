{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "events"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/collections/events.schema.json"
    },
    "schema_version": {
      "const": "3.0.0"
    },
    "events": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "actions",
              "date",
              "event_type",
              "id",
              "metrics",
              "outcomes",
              "participants",
              "product_refs",
              "related_event_refs",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "actions": {
                "type": [
                  "array"
                ]
              },
              "agreement_terms": {
                "type": [
                  "array"
                ]
              },
              "date": {
                "type": [
                  "object"
                ]
              },
              "event_type": {
                "type": [
                  "string"
                ]
              },
              "id": {
                "type": [
                  "string"
                ]
              },
              "metrics": {
                "type": [
                  "array"
                ]
              },
              "outcomes": {
                "type": [
                  "array"
                ]
              },
              "participants": {
                "type": [
                  "array"
                ]
              },
              "product_refs": {
                "type": [
                  "array"
                ]
              },
              "related_event_refs": {
                "type": [
                  "array"
                ]
              },
              "title": {
                "type": [
                  "string"
                ]
              },
              "agreement_ref": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
