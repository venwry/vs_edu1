{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "supplier_programs"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/collections/sourcing.schema.json"
    },
    "schema_version": {
      "const": "3.0.0"
    },
    "supplier_programs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "agreement_date",
              "cost_boundary",
              "date_precision",
              "id",
              "initial_sales_date",
              "launch_source",
              "manufacturer",
              "part_refs",
              "qualification_gates",
              "qualification_status",
              "rights",
              "transfer_deliverables"
            ],
            "additionalProperties": false,
            "properties": {
              "agreement_date": {
                "type": [
                  "string"
                ]
              },
              "cost_boundary": {
                "type": [
                  "string"
                ]
              },
              "date_precision": {
                "type": [
                  "string"
                ]
              },
              "id": {
                "type": [
                  "string"
                ]
              },
              "initial_sales_date": {
                "type": [
                  "string"
                ]
              },
              "launch_source": {
                "type": [
                  "string"
                ]
              },
              "manufacturer": {
                "type": [
                  "string"
                ]
              },
              "part_refs": {
                "type": [
                  "array"
                ]
              },
              "qualification_gates": {
                "type": [
                  "array"
                ]
              },
              "qualification_status": {
                "type": [
                  "string"
                ]
              },
              "rights": {
                "type": [
                  "string"
                ]
              },
              "transfer_deliverables": {
                "type": [
                  "array"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
