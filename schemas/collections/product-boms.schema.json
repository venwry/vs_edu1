{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "metadata",
    "products",
    "offers",
    "open_decisions",
    "costing_inputs",
    "proposed_offer_refs"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/collections/product-boms.schema.json"
    },
    "schema_version": {
      "const": "3.0.0"
    },
    "metadata": {
      "type": [
        "array",
        "object"
      ]
    },
    "products": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "assembly_refs",
              "catalog_ref",
              "production_status",
              "requirements"
            ],
            "additionalProperties": false,
            "properties": {
              "assembly_refs": {
                "type": [
                  "array"
                ]
              },
              "catalog_ref": {
                "type": [
                  "string"
                ],
                "minLength": 1
              },
              "production_status": {
                "type": [
                  "string"
                ]
              },
              "requirements": {
                "type": [
                  "array"
                ]
              }
            }
          }
        ]
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "assembly_ref",
              "availability_status",
              "catalog_ref",
              "compatible_host_ref",
              "effective_from",
              "included_host",
              "kind",
              "licenses_and_services",
              "requirements",
              "shipping_date"
            ],
            "additionalProperties": false,
            "properties": {
              "assembly_ref": {
                "type": [
                  "string"
                ],
                "minLength": 1
              },
              "availability_status": {
                "type": [
                  "string"
                ]
              },
              "catalog_ref": {
                "type": [
                  "string"
                ],
                "minLength": 1
              },
              "compatible_host_ref": {
                "type": [
                  "string"
                ],
                "minLength": 1
              },
              "effective_from": {
                "type": [
                  "string"
                ]
              },
              "included_host": {
                "type": [
                  "boolean"
                ]
              },
              "kind": {
                "type": [
                  "string"
                ]
              },
              "licenses_and_services": {
                "type": [
                  "string"
                ]
              },
              "requirements": {
                "type": [
                  "array"
                ]
              },
              "shipping_date": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "variants": {
                "type": [
                  "array"
                ]
              }
            }
          }
        ]
      }
    },
    "open_decisions": {
      "type": [
        "array",
        "object"
      ]
    },
    "costing_inputs": {
      "type": [
        "array",
        "object"
      ]
    },
    "proposed_offer_refs": {
      "type": [
        "array",
        "object"
      ]
    }
  }
}
