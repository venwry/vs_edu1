{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "services",
    "team_development_program"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/collections/services.schema.json"
    },
    "schema_version": {
      "const": "3.0.0"
    },
    "services": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "category",
              "id",
              "introduced",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "availability_note": {
                "type": [
                  "string"
                ]
              },
              "bundled_for_one_year_with": {
                "type": [
                  "array"
                ]
              },
              "category": {
                "type": [
                  "string"
                ]
              },
              "commercial_policy": {
                "type": [
                  "string"
                ]
              },
              "completion": {
                "type": [
                  "object"
                ]
              },
              "courses": {
                "type": [
                  "array"
                ]
              },
              "delivery": {
                "type": [
                  "string"
                ]
              },
              "delivery_unit": {
                "type": [
                  "string"
                ]
              },
              "description": {
                "type": [
                  "string"
                ]
              },
              "details": {
                "type": [
                  "string"
                ]
              },
              "engineering_hours": {
                "type": [
                  "number"
                ]
              },
              "exclusions": {
                "type": [
                  "array"
                ]
              },
              "features": {
                "type": [
                  "array"
                ]
              },
              "id": {
                "type": [
                  "string"
                ]
              },
              "includes": {
                "type": [
                  "array"
                ]
              },
              "introduced": {
                "type": [
                  "object"
                ]
              },
              "launch_program": {
                "type": [
                  "object"
                ]
              },
              "name": {
                "type": [
                  "string"
                ]
              },
              "openness_policy": {
                "type": [
                  "string"
                ]
              },
              "price_usd": {
                "type": [
                  "number"
                ]
              },
              "pricing_history_usd_per_year": {
                "type": [
                  "array"
                ]
              },
              "pricing_rule": {
                "type": [
                  "string"
                ]
              },
              "scope": {
                "type": [
                  "string"
                ]
              },
              "second_source_program": {
                "type": [
                  "object"
                ]
              }
            }
          }
        ]
      }
    },
    "team_development_program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license",
        "delivery"
      ],
      "properties": {
        "license": {
          "type": "object"
        },
        "delivery": {
          "type": "object"
        }
      }
    }
  }
}
