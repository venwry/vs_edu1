{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "../schemas/collections/components.schema.json"
    },
    "schema_version": {
      "const": "3.3.0"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "introduced",
          "bom_role"
        ],
        "properties": {
          "bom_assembly_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^assembly\\."
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "category": {
            "$ref": "urn:logix-aion:category:2"
          },
          "id": {
            "type": "string",
            "pattern": "^part\\.[a-z0-9_.]+$"
          },
          "introduced": {
            "type": "object",
            "required": [
              "event_name"
            ],
            "properties": {
              "event_name": {
                "type": "string"
              },
              "event_start_date": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "manufacturing_planning": {
            "type": [
              "object"
            ]
          },
          "manufacturing_process_ref": {
            "type": [
              "string"
            ],
            "minLength": 1
          },
          "manufacturing_status": {
            "type": [
              "string"
            ]
          },
          "name": {
            "type": [
              "string"
            ]
          },
          "origin": {
            "type": [
              "string"
            ]
          },
          "product_status": {
            "type": [
              "string"
            ]
          },
          "revision": {
            "type": [
              "string"
            ]
          },
          "second_source": {
            "type": [
              "object"
            ]
          },
          "specification": {
            "type": [
              "object"
            ]
          },
          "specification_ref": {
            "type": [
              "string"
            ],
            "minLength": 1
          },
          "superseded_by": {
            "type": [
              "array"
            ]
          },
          "technology_refs": {
            "type": [
              "array"
            ]
          },
          "used_in": {
            "type": [
              "array"
            ]
          },
          "vendor": {
            "type": [
              "string"
            ]
          },
          "manufacturer": {
            "type": [
              "null",
              "string"
            ]
          },
          "manufacturer_part_number": {
            "type": "string",
            "minLength": 1
          },
          "qualification_status": {
            "type": [
              "string"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "candidate_manufacturers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "basis"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "bom_role": {
            "enum": [
              "material",
              "assembly",
              "specification"
            ],
            "description": "Material: physical BOM leaf with cost inputs; assembly: composed component; specification: no released constituent BOM. Not a sales/availability flag."
          },
          "alternate_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "bom_role": {
                  "const": "material"
                }
              }
            },
            "then": {
              "required": [
                "qualification_status"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "bom_role": {
                  "const": "assembly"
                }
              }
            },
            "then": {
              "required": [
                "bom_assembly_refs"
              ]
            }
          },
          {
            "not": {
              "properties": {
                "category": {
                  "const": "memory_module"
                }
              },
              "required": [
                "category"
              ]
            }
          }
        ]
      }
    }
  }
}
