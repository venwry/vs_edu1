                "type": [
                  "array"
                ]
              },
              "api_compatibility": {
                "type": [
                  "string"
                ]
              },
              "architecture": {
                "type": [
                  "object"
                ]
              },
              "artemis_native_extensions": {
                "type": [
                  "array"
                ]
              },
              "base_product_ref": {
                "type": [
                  "string"
                ],
                "minLength": 1
              },
              "base_version": {
                "type": [
                  "string"
                ]
              },
              "bundled_with": {
                "type": [
                  "array"
                ]
              },
              "business_module_lineage": {
                "type": [
                  "string"
                ]
              },
              "compatibility_notes": {
                "type": [
                  "array"
                ]
              },
              "compatibility_policy": {
                "type": [
                  "object"
                ]
              },
              "components": {
                "type": [
                  "object"
                ]
              },
              "contents": {
                "type": [
                  "array"
                ]
              },
              "data_interchange": {
                "type": [
                  "object"
                ]
              },
              "dated_revisions": {
                "type": [
                  "array"
                ]
              },
              "delivery_on_artemis": {
                "type": [
                  "string"
                ]
              },
              "description": {
                "type": [
                  "string"
                ]
              },
              "design_continuity_with": {
                "type": [
                  "string"
                ]
              },
              "development_lineage": {
                "type": [
                  "string"
                ]
              },
              "ecosystem_policy": {
                "type": [
                  "object"
                ]
              },
              "edition_relationship": {
                "type": [
                  "string"
                ]
              },
              "embedded_abacus_integration_ref": {
                "type": [
                  "string"
                ],
                "minLength": 1
              },
              "explicitly_not_assumed": {
                "type": [
                  "array"
                ]
              },
              "extensions": {
                "type": [
                  "array"
                ]
              },
              "feature_status": {
                "type": [
                  "string"
                ]
              },
              "features": {
                "type": [
                  "array"
                ]
              },
              "features_ref": {
                "type": [
                  "string"
                ],
                "minLength": 1
              },
              "forward_compatibility_commitment": {
                "type": [
                  "object"
                ]
              },
              "implementation": {
                "type": [
                  "object",
                  "string"
                ]
              },
              "independent_implementation_policy": {
                "type": [
                  "string"
                ]
              },
              "internal_organization": {
                "type": [
                  "array"
                ]
              },
              "internal_relationships": {
                "type": [
                  "array"
                ]
              },
              "launch_acceptance_requirements": {
                "type": [
                  "object"
                ]
              },
              "launch_positioning": {
                "type": [
                  "string"
                ]
              },
              "licensing": {
                "type": [
                  "string"
                ]
              },
              "logix_requirements": {
                "type": [
                  "array"
                ]
              },
              "manufacturing_boundary": {
                "type": [
                  "string"
                ]
              },
              "memory_discovery_ref": {
                "type": [
                  "string"
                ],
                "minLength": 1
              },
              "modules": {
                "type": [
                  "array"
                ]
              },
              "mouse_update": {
                "type": [
                  "object"
                ]
              },
              "network_link_policy": {
                "type": [
                  "object"
                ]
              },
              "partner_distribution": {
                "type": [
                  "object"
                ]
              },
              "planned_for": {
                "type": [
                  "array"
                ]
              },
              "platform_policy": {
                "type": [
                  "string"
                ]
              },
              "portability_contract": {
                "type": [
                  "object"
                ]
              },
              "portable_runtime": {
                "type": [
                  "object"
                ]
              },
              "positioning": {
                "type": [
                  "string"
                ]
              },
              "product_status": {
                "type": [
                  "string"
                ]
              },
              "programmatic_file_access": {
                "type": [
                  "string"
                ]
              },
              "relationship": {
                "type": [
                  "string"
                ]
              },
              "release_scope": {
                "type": [
                  "object"
                ]
              },
              "reporting": {
                "type": [
                  "object"
                ]
              },
              "roadmap_1979": {
                "type": [
                  "string"
                ]
              },
              "runtime_notes": {
                "type": [
                  "array"
                ]
              },
              "sources": {
                "type": [
                  "array"
                ]
              },
              "specification": {
                "type": [
                  "object",
                  "string"
                ]
              },
              "subcomponents": {
                "type": [
                  "array"
                ]
              },
              "system_dependencies": {
                "type": [
                  "array"
                ]
              },
              "technology_ref": {
                "type": [
                  "string"
                ],
                "minLength": 1
              },
              "technology_refs": {
                "type": [
                  "array"
                ]
              },
              "toolchain": {
                "type": [
                  "object"
                ]
              },
              "training_available": {
                "type": [
                  "boolean"
                ]
              },
              "tui_features": {
                "type": [
                  "array"
                ]
              },
              "tui_integration": {
                "type": [
                  "string"
                ]
              },
              "tui_ownership": {
                "type": [
                  "object"
                ]
              },
              "unspecified": {
                "type": [
                  "array"
                ]
              },
              "validation": {
                "type": [
                  "string"
                ]
              },
              "vanilla_architecture": {
                "type": [
                  "object"
                ]
              },
              "vendor": {
                "type": "string"
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "edition": {
                "type": "string",
                "minLength": 1
              },
              "bom_assembly_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^assembly\\."
                }
              },
              "software_line_id": {
                "type": "string"
              },
              "software_line_name": {
                "type": "string"
              },
              "software_line_category": {
                "$ref": "urn:logix-aion:category:2"
              },
              "distribution": {
                "type": "object"
              },
              "composition_history": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "valid_from",
                    "valid_to",
                    "version_number",
                    "composition_definition"
                  ],
                  "properties": {
                    "valid_from": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "valid_to": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "version_number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "composition_definition": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "ref",
                          "quantity",
                          "unit",
                          "role",
                          "condition",
                          "quantity_status"
                        ],
                        "properties": {
                          "ref": {
                            "type": "string"
                          },
                          "quantity": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "exclusiveMinimum": 0
                          },
                          "unit": {
                            "type": "string"
                          },
                          "role": {
                            "type": "string"
                          },
                          "condition": {
                            "type": "string"
                          },
                          "quantity_status": {
                            "enum": [
                              "defined",
                              "unresolved"
                            ]
                          },
                          "element_type": {
                            "enum": [
                              "main_product",
                              "connected_device",
                              "attached_product"
                            ]
                          },
                          "used_socket": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "connected_to": {
                            "type": "string"
                          },
                          "qualification_status": {
                            "type": "string"
                          },
                          "duration_years": {
                            "type": "number"
                          },
                          "placements": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    },
                    "legacy_assembly_ref": {
                      "type": "string"
                    },
                    "unresolved_items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "composition_status": {
                      "enum": [
                        "unresolved"
                      ]
                    },
                    "date_status": {
                      "enum": [
                        "unknown"
                      ]
                    },
                    "bom_assembly_metadata": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
