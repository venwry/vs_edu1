{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "software_editions"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/collections/software-editions.schema.json"
    },
    "schema_version": {
      "const": "4.0.0"
    },
    "software_editions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "dependency_refs",
              "execution_target",
              "id",
              "introduced",
              "minimum_resources",
              "name",
              "platform_support",
              "role",
              "support_status",
              "version",
              "edition",
              "software_line_id",
              "software_line_name",
              "software_line_category",
              "vendor",
              "distribution",
              "composition_history"
            ],
            "additionalProperties": false,
            "properties": {
              "dependency_refs": {
                "type": [
                  "array"
                ]
              },
              "execution_target": {
                "type": [
                  "string"
                ]
              },
              "id": {
                "type": [
                  "string"
                ]
              },
              "introduced": {
                "type": [
                  "object"
                ]
              },
              "minimum_resources": {
                "type": [
                  "object"
                ]
              },
              "name": {
                "type": [
                  "string"
                ]
              },
              "platform_support": {
                "type": [
                  "array"
                ]
              },
              "role": {
                "type": [
                  "string"
                ]
              },
              "support_status": {
                "type": [
                  "string"
                ]
              },
              "abacus_file_integration": {
                "type": [
                  "object"
                ]
              },
