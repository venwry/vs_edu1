        "assembly_refs",
        "catalog_ref",
        "production_status",
        "requirements"
      ],
      "additionalProperties": false,
      "properties": {
        "assembly_refs": {
          "type": [
            "array"
          ]
        },
        "catalog_ref": {
          "type": [
            "string"
          ],
          "minLength": 1
        },
        "production_status": {
          "type": [
            "string"
          ]
        },
        "requirements": {
          "type": [
            "array"
          ]
        }
      }
    }
