{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "technology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "record_type",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "const": "technology"
    },
    "data": {
      "type": "object",
      "required": [
        "category",
        "id",
        "introduced",
        "name",
        "specification",
        "used_by"
      ],
      "additionalProperties": false,
      "properties": {
        "call_sequence": {
          "type": [
            "array"
          ]
        },
        "category": {
          "type": [
            "string"
          ]
        },
        "description": {
          "type": [
            "string"
          ]
        },
        "device_refs": {
          "type": [
            "array"
          ]
        },
        "full_ram_explanation": {
          "type": [
            "string"
          ]
        },
        "id": {
          "type": [
            "string"
          ]
        },
        "introduced": {
          "type": [
            "object"
          ]
        },
        "milestones": {
          "type": [
            "array"
          ]
        },
        "name": {
          "type": [
            "string"
          ]
        },
        "normal_map_explanation": {
          "type": [
            "string"
          ]
        },
        "owner": {
          "type": [
            "string"
          ]
        },
        "public_roadmap": {
          "type": [
            "object"
          ]
        },
        "regions": {
          "type": [
            "array"
          ]
        },
        "requirements": {
          "type": [
            "array"
          ]
        },
        "specification": {
          "type": [
            "object"
          ]
        },
        "technology_refs": {
          "type": [
            "array"
          ]
        },
        "used_by": {
          "type": [
            "array"
          ]
        }
      }
    }
  }
}
