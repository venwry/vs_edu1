{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "phase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "record_type",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "const": "phase"
    },
    "data": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "period",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": [
            "string"
          ]
        },
        "kind": {
          "type": [
            "string"
          ]
        },
        "period": {
          "type": [
            "object"
          ]
        },
        "title": {
          "type": [
            "string"
          ]
        }
      }
    }
  }
}
