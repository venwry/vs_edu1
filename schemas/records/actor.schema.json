{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "actor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "record_type",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "const": "actor"
    },
    "data": {
      "type": "object",
      "required": [
        "aliases",
        "description",
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": [
            "array"
          ]
        },
        "description": {
          "type": [
            "string"
          ]
        },
        "id": {
          "type": [
            "string"
          ]
        },
        "name": {
          "type": [
            "string"
          ]
        },
        "type": {
          "type": [
            "string"
          ]
        }
      }
    }
  }
}
