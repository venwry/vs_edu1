{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "document.team_development_program data/business/programs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "record_type",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "const": "document-section"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "financial_boundary",
        "pending_investment_costs",
        "campaign_costs",
        "totals",
        "assumptions",
        "financial_integration",
        "adoption_pricing"
      ],
      "properties": {
        "financial_boundary": {
          "type": "string"
        },
        "pending_investment_costs": {
          "type": "array"
        },
        "campaign_costs": {
          "type": "array"
        },
        "totals": {
          "type": "object"
        },
        "assumptions": {
          "type": "string"
        },
        "financial_integration": {
          "type": "object"
        },
        "adoption_pricing": {
          "type": "object"
        }
      }
    }
  }
}
