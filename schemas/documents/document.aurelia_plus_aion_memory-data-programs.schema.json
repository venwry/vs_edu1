{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "document.aurelia_plus_aion_memory data/programs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "record_type",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "const": "document-section"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_commit",
        "maturity_multiplier",
        "development",
        "capacity"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "source_commit": {
          "type": "string"
        },
        "maturity_multiplier": {
          "type": "number"
        },
        "development": {
          "type": "string"
        },
        "capacity": {
          "type": "string"
        }
      }
    }
  }
}
