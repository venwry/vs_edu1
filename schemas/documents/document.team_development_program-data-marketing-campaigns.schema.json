{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "document.team_development_program data/marketing/campaigns",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "record_type",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "const": "document-section"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_message",
        "campaign_promise",
        "claim_policy"
      ],
      "properties": {
        "campaign_message": {
          "type": "string"
        },
        "campaign_promise": {
          "type": "string"
        },
        "claim_policy": {
          "type": "string"
        }
      }
    }
  }
}
