{
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "source_catalog_version": {
          "type": "string"
        },
        "quantity_policy": {
          "type": "string"
        },
        "cost_policy": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "status",
        "source_catalog_version",
        "quantity_policy",
        "cost_policy"
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "assemblies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assembly"
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/offer"
      }
    },
    "proposed_offer_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "costing_inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "required_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "required_fields"
        ],
        "additionalProperties": false
      }
    },
    "supplier_programs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "manufacturer",
          "agreement_date",
          "initial_sales_date",
          "date_precision",
          "part_refs",
          "launch_source",
          "qualification_status",
          "rights",
          "transfer_deliverables",
          "qualification_gates",
          "cost_boundary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "agreement_date": {
            "type": "string"
          },
          "initial_sales_date": {
            "type": "string"
          },
          "date_precision": {
            "type": "string"
          },
          "part_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "launch_source": {
            "type": "string"
          },
          "qualification_status": {
            "type": "string"
          },
          "rights": {
            "type": "string"
          },
          "transfer_deliverables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "qualification_gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cost_boundary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "metadata",
    "components",
    "assemblies",
    "products",
    "offers",
    "proposed_offer_refs",
    "open_decisions",
    "costing_inputs",
    "supplier_programs"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Logix engineering BOM and costing readiness",
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "introduced",
        "bom_role"
      ],
      "properties": {
        "bom_assembly_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^assembly\\."
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "category": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:logix-aion:category:2",
          "title": "Canonical BOM product and component category",
          "description": "Functional category, independent of record type, platform, availability and supplier qualification. Editions inherit the parent product category.",
          "type": "string",
          "enum": [
            "bus_interface_and_control_assembly",
            "business_application_suite",
            "cable_kit",
            "cad_software",
            "cartridge_board_and_connector",
            "compiler",
            "computer",
            "connector",
            "crt_display_assembly",
            "crt_tube",
            "development_environment",
            "diode",
            "display_controller_ic",
            "display_deflection_component",
            "display_power_and_deflection_assembly",
            "dma_controller_ic",
            "educational_and_entertainment_software",
            "enclosure",
            "external_floppy_drive",
            "firmware_memory",
            "floppy_drive_mechanism",
            "graphics_controller_ic",
            "hard_disk_drive",
            "input_controller_assembly",
            "interconnect_and_passive_component_kit",
            "interface_integration_allowance",
            "io_controller_ic",
            "io_interface_assembly",
            "io_interface_expansion",
            "keyboard",
            "keyboard_controller_assembly",
            "keycap",
            "memory_assembly",
            "memory_controller_assembly",
            "memory_expansion",
            "memory_ic",
            "memory_identification_circuitry",
            "memory_management_ic",
            "memory_module",
            "monitor",
            "mouse",
            "mouse_encoder_mechanism",
            "network_controller_assembly",
            "network_hub_repeater",
            "network_interface_card",
            "network_transceiver_assembly",
            "office_suite",
            "operating_system",
            "operating_system_networking_extension",
            "packaging_and_documentation_kit",
            "passive_and_protection_components",
            "power_supply",
            "printed_circuit_board",
            "printer",
            "printer_controller_assembly",
            "printer_driver_electronics",
            "printer_mechanism",
            "printer_ribbon",
            "processor_expansion",
            "processor_ic",
            "programming_language",
            "scripting_environment",
            "software_development_kit",
            "software_distribution_medium",
            "spreadsheet_software",
            "storage_controller_assembly",
            "storage_controller_ic",
            "switch",
            "system_bundle",
            "system_controller_ic",
            "upgrade_bundle",
            "video_amplifier",
            "video_dac_and_amplifier_assembly",
            "video_dac_ic",
            "video_expansion_card",
            "video_interface_assembly",
            "video_receiver_and_amplifier_assembly",
            "video_receiver_assembly",
            "video_receiver_board",
            "video_timing_and_interface_assembly"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^part\\.[a-z0-9_.]+$"
        },
        "introduced": {
          "type": "object",
          "required": [
            "event_name"
          ],
          "properties": {
            "event_name": {
              "type": "string"
            },
            "event_start_date": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "manufacturing_planning": {
          "type": [
            "object"
          ]
        },
        "manufacturing_process_ref": {
          "type": [
            "string"
          ],
          "minLength": 1
        },
        "manufacturing_status": {
          "type": [
            "string"
          ]
        },
        "name": {
          "type": [
            "string"
          ]
        },
        "origin": {
          "type": [
            "string"
          ]
        },
        "product_status": {
          "type": [
            "string"
          ]
        },
        "revision": {
          "type": [
            "string"
          ]
        },
        "second_source": {
          "type": [
            "object"
          ]
        },
        "specification": {
          "type": [
            "object"
          ]
        },
        "specification_ref": {
          "type": [
            "string"
          ],
          "minLength": 1
        },
        "superseded_by": {
          "type": [
            "array"
          ]
        },
        "technology_refs": {
          "type": [
            "array"
          ]
        },
        "used_in": {
          "type": [
            "array"
          ]
        },
        "variants": {
          "type": [
            "array"
          ]
        },
        "vendor": {
          "type": [
            "string"
          ]
        },
        "manufacturer": {
          "type": [
            "null",
            "string"
          ]
        },
        "manufacturer_part_number": {
          "type": "string",
          "minLength": 1
        },
        "qualification_status": {
          "type": [
            "string"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "candidate_manufacturers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "basis"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "bom_role": {
          "enum": [
            "material",
            "assembly",
            "specification"
          ],
          "description": "Material: physical BOM leaf with cost inputs; assembly: composed component; specification: no released constituent BOM. Not a sales/availability flag."
        },
        "alternate_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "bom_role": {
                "const": "material"
              }
            }
          },
          "then": {
            "required": [
              "qualification_status"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "bom_role": {
                "const": "assembly"
              }
            }
          },
          "then": {
            "required": [
              "bom_assembly_refs"
            ]
          }
        }
      ]
    },
    "line": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "quantity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "unit": {
          "const": "each"
        },
        "role": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "quantity_status": {
          "enum": [
            "defined",
            "unresolved"
          ]
        }
      },
      "required": [
        "ref",
        "quantity",
        "unit",
        "role",
        "condition",
        "quantity_status"
      ],
      "additionalProperties": false
    },
    "assembly": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(assembly|device)\\."
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routing": {
          "type": "object",
          "properties": {
            "operations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "minutes_per_unit": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "first_pass_yield": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "rework_rate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "scrap_rate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "fixture_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "operations",
            "minutes_per_unit",
            "first_pass_yield",
            "rework_rate",
            "scrap_rate",
            "fixture_refs"
          ],
          "additionalProperties": false
        },
        "cost_rollup_status": {
          "type": "string"
        },
        "ram_configuration_id": {
          "type": "string"
        },
        "shipping_configuration": {
          "type": "boolean"
        },
        "effective_from": {
          "type": "string"
        },
        "cost_assessment_status": {
          "enum": [
            "pending_reassessment",
            "assessed"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "lines",
        "requirements",
        "routing",
        "cost_rollup_status"
      ],
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "properties": {
        "catalog_ref": {
          "type": "string"
        },
        "production_status": {
          "enum": [
            "excluded",
            "design_baseline"
          ]
        },
        "assembly_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "catalog_ref",
        "production_status",
        "assembly_refs",
        "requirements"
      ],
      "additionalProperties": false
    },
    "offer": {
      "type": "object",
      "properties": {
        "catalog_ref": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "upgrade_kit",
            "system_bundle"
          ]
        },
        "assembly_ref": {
          "type": "string"
        },
        "compatible_host_ref": {
          "type": "string"
        },
        "included_host": {
          "type": "boolean"
        },
        "effective_from": {
          "type": "string"
        },
        "shipping_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "availability_status": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licenses_and_services": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "effective_from": {
                "type": "string"
              },
              "assembly_ref": {
                "type": "string"
              }
            },
            "required": [
              "effective_from",
              "assembly_ref"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "catalog_ref",
        "kind",
        "assembly_ref",
        "compatible_host_ref",
        "included_host",
        "effective_from",
        "shipping_date",
        "availability_status",
        "requirements",
        "licenses_and_services"
      ],
      "additionalProperties": false
    }
  }
}
