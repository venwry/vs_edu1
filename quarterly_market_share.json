{
  "metadata": {
    "title": "Quarterly microcomputer market share",
    "period": "1981-Q1–1983-Q4",
    "status": "Alternative-history unit-shipment scenario; quarterly market totals are modelled, not observed",
    "scope": "Worldwide microcomputer unit shipments; Logix includes UK distributor shipments. Five clone brands counted only for their compatible product lines. Other legacy products of those brands remain in other manufacturers."
  },
  "methodology": {
    "historical_calibration_units": {
      "1981": 1400000,
      "1982": 2800000
    },
    "1983_planning_units": 5000000,
    "quarter_weights": [
      0.21,
      0.23,
      0.25,
      0.31
    ],
    "incremental_platform_demand_fraction": 0.2,
    "definition": "Complete microcomputers, including home/business models; exclude peripherals, terminals, upgrades and software. Shipment-unit share, not revenue or installed-base share.",
    "basis": "1981/1982 contemporaneous Dataquest estimates reported by TIME; scope comparability is approximate. 1983 round planning assumption, not a sourced historical count. Quarterly allocation 21/23/25/31 is modelled, not observed. Add only 20% of Logix+clone demand to the calibrated market; the remainder displaces other suppliers.",
    "source_url": "https://time.com/archive/6699317/the-computer-moves-in/",
    "source_title": "TIME, The Computer Moves In, January 1983"
  },
