      "sprites": {
        "count": 5,
        "maximum_per_scanline": 5,
        "width": 16,
        "height": 16,
        "bits_per_pixel": 4,
        "pattern_bytes_per_sprite": 128,
        "transparent_index": 0,
        "coordinate_space": "Logical mode pixels; scale together with the background. Signed 16-bit X and Y; clip at screen edges.",
        "priority": "Lower sprite number wins; all sprites overlay background/text.",
        "registers": "Two descriptor banks hold signed 16-bit X/Y, enable and reserved controls. CPU/DMA uses auto-incrementing SRAM upload ports.",
        "updates": "Switch descriptor bank atomically at vertical blank. Pattern writes require scheduled access or disabling affected sprites; 1 KiB does not hold two complete pattern sets.",
        "allocation_policy": "Five sprites in every text/bitmap mode, including double-buffered backgrounds. Sprite SRAM never consumes display DRAM.",
        "pattern_bytes_total": 640,
        "descriptor_bytes_per_sprite": 8,
        "descriptor_bank_count": 2,
        "descriptor_bytes_total": 128,
        "reserved_sprite_sram_bytes": 1024,
        "spare_sprite_sram_bytes": 256,
        "available_in_all_modes": true,
        "pattern_double_buffered": false,
        "descriptor_allocation_note": "80 bytes of live two-bank descriptors within a 128-byte reserved area; 48 bytes padding. 640 pattern + 128 descriptor + 256 scratch bytes = 1024."
      },
      "sprite_memory": {
        "chip_ref": "part.aion_2114",
        "chip_count": 2,
        "bank_data_width_bits": 8,
        "capacity_bytes": 1024,
        "separate_bus": true,
        "separate_from_system_and_display_ram": true
      },
      "video_ram_kb": 32,
      "card_ref": "device.artemis_video_card",
      "display_memory": {
        "chip_ref": "part.aion_4116",
        "chip_count": 16,
        "capacity_bytes": 32768,
        "bank_data_width_bits": 16,
        "organization": "16K × 16 bits; ordinary external DRAM, independent display refresh sequencer."
      },
      "pixel_buffer": {
        "pages": 4,
        "bytes_per_page": 160,
        "total_bytes": 640,
        "pixels_per_page": 320,
        "bits_per_pixel": 4,
        "location": "On video ASIC; SRAM banks with page ownership latches",
        "page_states": [
          "free",
          "filling",
          "ready",
          "displaying"
        ],
        "policy": "Eight-pixel parallel renderer fills free pages; independent clocked serializer drains ready pages. Two pages per 640-pixel line; prefill before active display; never overwrite displaying pages. Underflow blanks pixels, preserves sync and sets sticky fault.",
        "physical_organization": "Each 160-byte bank is 40 words × 32 bits. Load eight 4-bit pixels into a separate 32-bit serializer latch every eight dot clocks, then shift at 21.504 MHz. SRAM array reads run at 2.688 MHz, not one read per dot; filler and drain use different banks."
      },
      "character_row_cache": {
        "banks": 2,
        "bytes_per_bank": 160,
        "total_bytes": 320,
        "purpose": "Current and next 80-column character/attribute row; separate from 640-byte pixel FIFO."
      },
      "timing_budget": {
        "pixel_clock_mhz": 21.504,
        "renderer_pixels_per_step": 8,
        "renderer_step_mhz": 2.688,
        "page_drain_microseconds": 14.881,
        "qualification": "At 250 ns conservative DRAM cycle, 80 glyph fetches consume 20 microseconds per active line; 160-byte row prefetch amortizes across 8/10/16 scanlines. Two row caches and 16-bit reads cover text-row transitions. Verify sprites, refresh and bounded host/DMA slots together at voltage/temperature corners; no guaranteed maximum CPU upload rate."
      },
      "arbitration": "Card-local sequencer arbitrates display fetch and deadline-reserved independent DRAM refresh before bounded host/DMA transfers with READY. Sprite SRAM has its own 8-bit bus. System DMA/MMU remain dedicated host components; the card does not replace system-memory refresh.",
      "monitor_policy": "Read capability descriptor before enabling sync. Mono Pro accepts only raster_640_400; integer-scale legacy modes. Old monitors retain their advertised 200-line raster(s), never 640×400. Native 400-line modes require Mono Pro; new 200-line bitmap modes also work on capable older displays. This is display-mode/API compatibility, not Z80 binary compatibility."
    },
