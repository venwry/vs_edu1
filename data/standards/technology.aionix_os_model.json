{
  "$schema": "../../schemas/records/technology.schema.json",
  "schema_version": "1.0.0",
  "id": "technology.aionix_os_model",
  "record_type": "technology",
  "data": {
    "id": "technology.aionix_os_model",
    "name": "AIONix operating-system and ABI model",
    "category": "operating_system_architecture",
    "introduced": {
      "event_name": "NCC 1980 — Logix Artemis launch",
      "event_start_date": "1980-05-19"
    },
    "owner": "AION Software controlling roadmap; developed with Digital Research",
    "specification": {
      "programming_model": "recognizably Unix V7, simplified for small RAM",
      "minimum_design_target_ram_kb": 128,
      "rom_backed_executables": true,
      "fork": "copy-on-write",
      "process_limit_example": 6,
      "file_descriptors": true,
      "pipes": true,
      "signals": "drastically reduced",
      "mmap": "not full mmap()",
      "virtual_address_space_per_process": true,
      "symbolic_links": "not implemented initially; reserved",
      "networking_initial_release": false,
      "device_files": true,
      "dma": "hidden behind normal I/O",
      "ioctl": true,
      "directory_model": "Unix V7",
      "shell": "small shell",
      "utilities": "in ROM",
      "syscall_abi": "deliberately POSIX-shaped",
      "errno": true,
      "syscall_number_policy": "reserve aggressively",
      "stable_c_abi": true,
      "floating_point_abi": false,
      "brk_sbrk": true,
      "demand_paging": false,
      "user_kernel_modes": true,
      "interrupt_model": "simple",
      "permissions": "simple but real",
      "serial_as_tty": true,
      "rescue_unix_in_rom": true,
      "tui_api": true,
      "portable_api_ref": "technology.logix_c_api",
      "stable_c_abi_scope": "ERA target ABI, not binary compatibility with the Z80 target."
    },
    "used_by": [
      "computer.artemis",
      "computer.artemis_pro",
      "software.aionix",
      "software.aion_c_ide",
      "software.abacus_3",
      "software.pulse_3",
      "software.bpi_client_server"
    ]
  }
}
