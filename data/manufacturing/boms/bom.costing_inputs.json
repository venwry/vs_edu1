{
  "$schema": "../../../schemas/records/bom-policy.schema.json",
  "schema_version": "1.0.0",
  "id": "bom.costing_inputs",
  "record_type": "bom-policy",
  "data": {
    "materials": {
      "status": "unresolved",
      "required_fields": [
        "dated supplier quote",
        "currency",
        "volume tier",
        "MOQ",
        "freight/duty",
        "accepted-part yield"
      ]
