        "utilities",
        "maintenance",
        "supervision",
        "capacity/utilization",
        "allocation basis"
      ]
    },
    "nre_and_capital": {
      "status": "unresolved",
      "required_fields": [
        "masks",
        "engineering",
        "molds",
        "fixtures",
        "equipment",
        "depreciation or amortization basis"
      ]
    },
    "commercial": {
      "status": "unresolved",
      "required_fields": [
        "warranty",
        "support/training",
        "distribution",
        "retailer margin"
      ]
    }
